<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shared container holding the cache database. This is the extension's only capability:
	     it republishes what is already on the device and never reaches the network. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(HISTER_APP_GROUP)</string>
	</array>
</dict>
</plist>

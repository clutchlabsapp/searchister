// Shared build settings for every target.
//
// HISTER_APP_GROUP and HISTER_KEYCHAIN_GROUP are expanded inside the .entitlements files and read
// back at runtime through Info.plist (see HisterKit/Sources/HisterKit/Support/AppGroup.swift), so
// this is the only place they need to change. Point them at identifiers you have registered in
// your Apple Developer account.
HISTER_APP_GROUP = group.app.clutchlabs.searchister
HISTER_KEYCHAIN_GROUP = app.clutchlabs.searchister

// Set your team here, or create Config/Local.xcconfig (gitignored) containing:
//   DEVELOPMENT_TEAM = YOURTEAMID
#include? "Local.xcconfig"

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Searchister</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Read by AppGroup.swift so the app and the share extension resolve the same container. -->
	<key>HisterAppGroupIdentifier</key>
	<string>$(HISTER_APP_GROUP)</string>
	<key>HisterKeychainAccessGroup</key>
	<string>$(HISTER_KEYCHAIN_GROUP)</string>

	<!-- Must match AppDelegate.backgroundTaskIdentifier or BGTaskScheduler refuses to register. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.clutchlabs.searchister.sync</string>
	</array>

	<!-- Lets a Spotlight result group offer "Search all of Hister for …", handled in
	     SearchisterApp via CSQueryContinuationActionType. -->
	<key>CoreSpotlightContinuation</key>
	<true/>

	<!-- iOS-only keys; ignored on macOS. -->

	<!-- The launch screen is a dictionary rather than a UILaunchStoryboardName, because
	     Searchister is a single target that builds for both iOS and macOS: a storyboard added to
	     it is compiled for the Mac destination too, which fails with "iOS storyboards do not
	     support target device type Mac". macOS ignores this key outright instead.

	     UIImageName names the image set in Apps/Searchister/Assets.xcassets; it is scaled to fit
	     and centred over UIColorName, which is the icon's own fill colour. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchImage</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

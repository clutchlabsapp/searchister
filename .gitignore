# Xcode
# Searchister.xcodeproj is committed — it is the project, not a build artifact.
# Only the per-user state inside it is ignored. Note that ignoring `*.xcodeproj/`
# wholesale cannot be undone with a negation: git will not descend into an
# excluded directory to re-include a file within it.
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/

# Sources copied in by Scripts/linux-check.sh. Only the package manifest and the stubs are
# committed; everything else there is a copy of HisterKit and is rewritten on every run.
Scripts/LinuxCheck/Sources/
Scripts/LinuxCheck/Tests/
Scripts/LinuxCheck/Package.resolved

# macOS
.DS_Store

# Local machine configuration — DEVELOPMENT_TEAM and anything else personal
Config/Local.xcconfig
*.local.xcconfig

# Local secrets — never commit a Hister access token
Secrets.xcconfig
